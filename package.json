{
  "name": "kisso-onboarding",
  "version": "0.1.0",
  "description": "Plateforme d'onboarding intelligent pour Kisso Industries",
  "type": "module",
  "engines": {
    "node": ">=22.13.0"
  },
  "scripts": {
    "dev": "mastra dev",
    "build": "mastra build && node scripts/fix-vercel-output.js && npm run verify:bundle",
    "start": "npx tsx ./src/mastra/index.ts",
    "test": "vitest run",
    "test:unit": "vitest run",
    "test:integration": "vitest run --config vitest.config.integration.ts",
    "test:all": "npm run test:unit && npm run test:integration",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:scenarios": "node --env-file=.env scripts/production-scenarios.mjs",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "build:prod": "tsc --noEmit && mastra build && node scripts/fix-vercel-output.js && npm run verify:bundle",
    "start:prod": "node .mastra/index.mjs",
    "db:fts": "npx tsx --env-file=.env scripts/apply-ddl.mts scripts/ddl-channel-messages.sql && npx tsx --env-file=.env scripts/apply-ddl.mts scripts/ddl-knowledge-facts.sql",
    "db:init": "npx drizzle-kit export --dialect=sqlite --schema=./src/infrastructure/database/schema.ts | sqlite3 data/kisso.db",
    "profile:invite": "npx tsx --env-file=.env scripts/invite-profile-completion.mts",
    "directory:sync": "npx tsx --env-file=.env scripts/sync-slack-directory.mts",
    "directory:show": "npx tsx --env-file=.env scripts/show-directory.mts",
    "directory:prune": "npx tsx --env-file=.env scripts/prune-employees-without-slack.mts",
    "db:ddl": "npx tsx --env-file=.env scripts/apply-ddl.mts",
    "probe:replies": "npx tsx --env-file=.env scripts/probe-deterministic-replies.mts",
    "probe:erasure": "npx tsx --env-file=.env scripts/probe-erasure.mts",
    "probe:authz": "npx tsx --env-file=.env scripts/probe-authz.mts",
    "role:set": "npx tsx --env-file=.env scripts/set-role.mts",
    "smoke:slack": "node --env-file=.env scripts/smoke-slack.mjs",
    "smoke:email": "node --env-file=.env scripts/smoke-email.mjs",
    "verify:bundle": "node scripts/verify-vercel-bundle.js --require pdfkit,pdfmake,js-md5,fontkit,docx",
    "prepare": "husky",
    "lint": "eslint src --ext .ts",
    "format": "prettier --write .",
    "format:check": "prettier --check \"src/**/*.ts\""
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.48",
    "@ai-sdk/groq": "^4.0.24",
    "@ai-sdk/mistral": "^4.0.25",
    "@libsql/client": "^0.17.4",
    "@mastra/core": "^1.57.0",
    "@mastra/deployer-vercel": "^1.2.13",
    "@mastra/libsql": "^1.19.0",
    "@noble/hashes": "^2.2.0",
    "@opentelemetry/api": "^1.9.1",
    "@slack/web-api": "^8.0.0",
    "@types/nodemailer": "^8.0.1",
    "@types/pdfmake": "^0.3.3",
    "ai": "^7.0.55",
    "async-mutex": "^0.5.0",
    "better-sqlite3": "^12.11.1",
    "docx": "^9.7.1",
    "dotenv": "^17.4.2",
    "drizzle-orm": "^0.45.2",
    "lru-cache": "^11.5.2",
    "mastra": "^1.22.0",
    "nodemailer": "^9.0.4",
    "pdfkit": "^0.19.1",
    "pdfmake": "^0.3.11",
    "sanitize-html": "^2.17.5",
    "validator": "^13.15.35",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/node": "26.1.2",
    "@types/sanitize-html": "^2.16.1",
    "@types/validator": "^13.15.10",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "@vitest/coverage-v8": "^4.1.10",
    "drizzle-kit": "^0.31.10",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-security": "^4.0.1",
    "eslint-plugin-sonarjs": "^4.2.0",
    "globals": "^17.8.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.6",
    "semver": "^7.8.5",
    "tsx": "^4.19.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "4.1.10"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
