{
  "name": "kisso-onboarding",
  "version": "0.1.0",
  "description": "Plateforme d'onboarding intelligent pour Kisso Industries",
  "type": "module",
  "scripts": {
    "dev": "mastra dev",
    "build": "tsc",
    "start": "npx tsx ./src/mastra/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push",
    "build:prod": "tsc --noEmit && mastra build",
    "start:prod": "node .mastra/index.mjs",
    "db:init": "npx drizzle-kit export --dialect=sqlite --schema=./src/infrastructure/database/schema.ts | sqlite3 data/kisso.db",
    "smoke:slack": "node --env-file=.env scripts/smoke-slack.mjs",
    "prepare": "husky",
    "lint": "eslint . --ext .ts",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@ai-sdk/google": "^3.0.102",
    "@ai-sdk/openai": "^3.0.89",
    "@aws-sdk/client-secrets-manager": "^3.1101.0",
    "@mastra/core": "1.53.0",
    "@mastra/libsql": "^0.16.4",
    "@opentelemetry/api": "^1.9.1",
    "@slack/web-api": "^8.0.0",
    "@types/pdfmake": "^0.3.3",
    "async-mutex": "^0.5.0",
    "better-sqlite3": "13.0.1",
    "drizzle-orm": "0.45.2",
    "inngest": "^4.13.0",
    "isomorphic-dompurify": "^3.19.0",
    "lru-cache": "^11.5.2",
    "mastra": "1.20.2",
    "pdfmake": "^0.3.11",
    "resend": "^6.18.1",
    "validator": "^13.15.35",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "26.1.2",
    "@types/validator": "^13.15.10",
    "@typescript-eslint/eslint-plugin": "^8.65.0",
    "@typescript-eslint/parser": "^8.65.0",
    "drizzle-kit": "0.31.10",
    "eslint": "^10.8.0",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-security": "^4.0.1",
    "eslint-plugin-sonarjs": "^4.2.0",
    "globals": "^17.8.0",
    "husky": "^9.1.7",
    "lint-staged": "^16.4.0",
    "prettier": "^3.9.6",
    "tsx": "^4.19.0",
    "typescript": "6.0.3",
    "typescript-eslint": "^8.65.0",
    "vitest": "4.1.10"
  },
  "lint-staged": {
    "*.ts": [
      "eslint --fix",
      "prettier --write"
    ]
  }
}
