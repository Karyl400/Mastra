{
  "name": "kisso-onboarding",
  "version": "0.1.0",
  "description": "Plateforme d'onboarding intelligent pour Kisso Industries",
  "type": "module",
  "scripts": {
    "dev": "mastra dev",
    "build": "tsc",
    "start": "npx tsx ./src/mastra/index.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "db:generate": "drizzle-kit generate",
    "db:push": "drizzle-kit push"
  },
  "dependencies": {
    "@ai-sdk/google": "^3.0.102",
    "@ai-sdk/openai": "^3.0.89",
    "@mastra/core": "1.53.0",
    "@slack/web-api": "^8.0.0",
    "better-sqlite3": "13.0.1",
    "drizzle-orm": "0.45.2",
    "inngest": "^4.13.0",
    "mastra": "1.20.2",
    "resend": "^6.18.1",
    "zod": "3.25.76"
  },
  "devDependencies": {
    "@types/better-sqlite3": "7.6.13",
    "@types/node": "26.1.2",
    "drizzle-kit": "0.31.10",
    "tsx": "^4.19.0",
    "typescript": "6.0.3",
    "vitest": "4.1.10"
  }
}
