import sanitizeHtmlLib from "sanitize-html";


export function sanitizeHtml(value: unknown): string {
  if (typeof value !== "string") {
    return "";
  }

  return sanitizeHtmlLib(value.trim(), {
    allowedTags: [],
    allowedAttributes: {},
  });
}


export function sanitizeRichHtml(value: unknown): string {
  if (typeof value !== "string") {
    return "";
  }

  return sanitizeHtmlLib(value.trim(), {
    allowedTags: [
      "b",
      "i",
      "strong",
      "em",
      "p",
      "br",
      "ul",
      "ol",
      "li",
    ],
    allowedAttributes: {},
  });
}