# ──────────────────────────────────────────────
# Kisso Onboarding — Variables d'environnement
# Copier vers .env et remplir. NE JAMAIS committer .env.
# Liste dérivée d'un audit exhaustif de `process.env.*` dans src/ + scripts/.
# ──────────────────────────────────────────────

# ── Base de données (LibSQL / Turso) ─────────────────────────────────────────
# REQUIS : src/mastra/index.ts throw au boot si absent.
# Lu aussi par src/infrastructure/database/connection.ts et drizzle.config.ts.
# Défaut si absent côté connection.ts : file:./data/kisso.db
DATABASE_URL=libsql://[db-name]-[org].turso.io
DATABASE_AUTH_TOKEN=
# Optionnels (connection.ts)
AUTO_MIGRATE=false
DB_MIGRATIONS_FOLDER=./drizzle

# ── LLM ──────────────────────────────────────────────────────────────────────
# REQUIS : modèle primaire de TOUS les agents (Groq llama-3.3-70b-versatile).
GROQ_API_KEY=
# REQUIS : fallback de TOUS les agents (Mistral mistral-large-latest).
# Si absent, la moindre erreur Groq fait remonter
# "Mistral API key is missing" en HTTP 500. À déployer aussi sur Vercel.
MISTRAL_API_KEY=
# Lu UNIQUEMENT par src/config/index.ts (module actuellement jamais appelé).
OPENAI_API_KEY=

# ── Slack ────────────────────────────────────────────────────────────────────
# REQUIS : xoxb-… — SlackAdapter, SlackWorkspaceService, SlackEventsHandler.
SLACK_BOT_TOKEN=
# REQUIS pour l'endpoint Events API (vérification de signature HMAC).
SLACK_SIGNING_SECRET=

# ── Email (SMTP primaire, Brevo en repli) ────────────────────────────────────
# `createEmailProvider()` (src/mastra/index.ts) choisit SmtpAdapter dès que
# SMTP_HOST + SMTP_USER + SMTP_PASS sont TOUS renseignés, sinon BrevoAdapter.
# Arbitrage détaillé : docs/adr/006-fournisseur-email-smtp.md
#
# ⚠️ ÉCHEC SILENCIEUX : les workflows attrapent l'erreur d'envoi et posent
# `emailSent: false`, mais retournent quand même `status: 'success'`.
# Ne jamais conclure qu'un email est parti sans vérifier `emailSent`.
#
# Gmail : SMTP_PASS = mot de passe d'APPLICATION (16 car.), PAS celui du compte.
# Le mot de passe du compte est refusé : 534-5.7.9 Application-specific password
# required. Génération : Compte Google → Sécurité → Validation en deux étapes
# → Mots de passe des applications (la 2FA doit être active).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Expéditeur. Doit être autorisé par le serveur SMTP (pour Gmail : = SMTP_USER).
NOTIFICATION_FROM=

# Repli uniquement. La clé peut être valide (GET /v3/account → 200) tout en
# refusant d'envoyer : POST /v3/smtp/email → 403 "Your SMTP account is not yet
# activated". Blocage côté compte Brevo, aucun contournement par le code.
BREVO_API_KEY=

# ── Authentification de l'API Mastra ─────────────────────────────────────────
# REQUIS. Bearer token partagé exigé sur TOUTES les routes intégrées `/api/*`
# (`server.auth` dans src/mastra/index.ts → src/shared/security/api-auth.ts).
# Sans lui, `POST /api/agents/:id/generate` est ouvert à Internet : n'importe qui
# pilote les agents (envoi d'email depuis la vraie boîte, création d'employés,
# publication Slack).
#
# ⚠️ FAIL-CLOSED : si la variable est absente ou fait moins de 32 caractères,
# toutes les routes /api/* répondent 401. Un déploiement sans cette variable est
# donc en panne — c'est délibéré, l'alternative rouvrirait la faille en silence.
# `/slack/events` n'est PAS concerné (requiresAuth: false + signature HMAC Slack).
#
# Génération :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Appel authentifié :
#   curl -H "Authorization: Bearer $MASTRA_API_TOKEN" .../api/agents
MASTRA_API_TOKEN=

# ── Application ──────────────────────────────────────────────────────────────
LOG_LEVEL=debug                 # debug | info | warn | error
NODE_ENV=development            # development | staging | production | test
SERVICE_NAME=kisso-onboarding   # optionnel, métadonnée logger
APP_VERSION=0.1.0               # optionnel, métadonnée logger

# ── Production uniquement ────────────────────────────────────────────────────
# src/config/index.ts bascule sur AWS Secrets Manager quand NODE_ENV=production.
AWS_SECRET_ID=kisso/config

# ── Tests ────────────────────────────────────────────────────────────────────
# Cible de tests/integration/live-integration.test.ts.
# Défaut : https://mastra-71ya.vercel.app
# Ce test envoie `Authorization: Bearer $MASTRA_API_TOKEN` — le token doit être
# celui du déploiement visé, sinon tous les appels /api/* répondent 401.
LIVE_TEST_BASE_URL=
# Base utilisée par les tests d'intégration (tests/integration/setup.ts).
# Défaut : file:./data/integration-test.db
INTEGRATION_DATABASE_URL=

# ──────────────────────────────────────────────────────────────────────────────
# CONFIG MORTE — présente dans d'anciens .env, plus lue par AUCUN code :
#   RESEND_API_KEY            (resend.adapter.ts supprimé)
#   GOOGLE_GEMINI_API_KEY     (@ai-sdk/google installé mais jamais instancié)
#   SLACK_USER_TOKEN          (xoxp- ; seul SLACK_BOT_TOKEN est utilisé)
#   INNGEST_EVENT_KEY / INNGEST_SIGNING_KEY (inngest installé, jamais importé —
#                             candidat pour la file durable du traitement Slack)
# NB : SMTP_* N'EST PLUS de la config morte depuis le passage à nodemailer.
# ──────────────────────────────────────────────────────────────────────────────
