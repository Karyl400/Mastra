# ──────────────────────────────────────────────
# Kisso Onboarding — Variables d'environnement
# Copier vers .env et remplir. NE JAMAIS committer .env.
#
# ⚠️ Cette liste n'est PAS tenue à la main : elle est verrouillée par
# tests/unit/quality/env-example-completeness.test.ts, qui la confronte à tous les
# `process.env.X` de src/. Ajouter une lecture sans l'ajouter ici fait rougir la suite.
# ──────────────────────────────────────────────

# ── Base de données (LibSQL / Turso) ─────────────────────────────────────────
# REQUIS : src/mastra/index.ts throw au boot si absent. C'est la SEULE variable
# dont l'absence est fatale — rien ne peut fonctionner sans base.
# Lu aussi par src/infrastructure/database/connection.ts et drizzle.config.ts.
# Défaut si absent côté connection.ts : file:./data/kisso.db
DATABASE_URL=libsql://[db-name]-[org].turso.io
DATABASE_AUTH_TOKEN=
# Optionnels (connection.ts)
AUTO_MIGRATE=false
DB_MIGRATIONS_FOLDER=./drizzle

# ── LLM ──────────────────────────────────────────────────────────────────────
# La chaîne est Gemini → Groq → Mistral, dans cet ordre, et l'ORDRE EST LE CONTRAT.
# Chaque maillon absent est SAUTÉ ; si aucun n'est posé, `makeModelChain` LÈVE au
# lieu de rendre une chaîne vide — une chaîne vide échoue à des étages de distance
# de sa cause.
#
# REQUIS : modèle primaire de TOUS les agents depuis le 2026-08-20. Il remplace Groq,
# dont le quota JOURNALIER (100 000 tokens) bornait tout ce produit à ≈ 19 messages
# par jour, tous canaux confondus — c'est la contrainte qui gouvernait chaque
# décision de coût du dépôt.
GOOGLE_GEMINI_API_KEY=
# REQUIS : premier repli. Était le primaire jusqu'au 2026-08-20.
GROQ_API_KEY=
# REQUIS : dernier recours. ⚠️ Plafonné en REQUÊTES (4/min), donc INSENSIBLE à tout
# dégraissage de prompt : un flux multi-étapes l'épuise quel que soit son coût unitaire.
# Si absent, la moindre erreur des deux maillons précédents fait remonter
# "Mistral API key is missing" en HTTP 500. À déployer aussi sur Vercel.
MISTRAL_API_KEY=

# FACULTATIVES — identifiants des modèles, littéraux actuels en défaut :
#   GEMINI_MODEL_ID  → gemini-3.5-flash
#   GROQ_MODEL_ID    → openai/gpt-oss-120b
#   MISTRAL_MODEL_ID → mistral-large-latest
# Elles existent parce que le 2026-08-15 le modèle primaire a DISPARU du compte
# Groq (404 model_not_found) : le bot répondait encore — la chaîne de repli
# faisait son travail — mais chaque message payait un aller-retour perdu, et en
# changer a demandé un commit, un build et un déploiement.
# Poser la variable suffit désormais. `PRIMARY_MODEL_ID` / `FALLBACK_MODEL_ID`
# en sont DÉRIVÉS (src/shared/llm/model-fallback.ts) : l'étiquette et le modèle
# réellement demandé ne peuvent pas diverger.
# Vérifier ce que la clé sert vraiment, avant de conclure à un bug :
#   curl -s https://api.groq.com/openai/v1/models -H "Authorization: Bearer $GROQ_API_KEY"
#   curl -s https://generativelanguage.googleapis.com/v1beta/models -H "x-goog-api-key: $GOOGLE_GEMINI_API_KEY"
# ⚠️ Un modèle LISTÉ n'est pas forcément SERVI : `gemini-2.5-flash` figure dans la
# liste et répond 404 sur cette clé. Et un modèle qui répond 200 n'appelle pas
# forcément les outils — c'est ce test-là qui avait écarté `qwen/qwen3.6-27b`.
# ⚠️ Vérifier aussi sa DISPONIBILITÉ, pas seulement sa réponse à une requête :
# `gemini-3.7-flash` rend 503 « high demand » une fois sur trois. La chaîne rattrape,
# mais chaque message paie alors un aller-retour perdu — le mode de panne exact de
# `llama-3.3-70b-versatile`. Relevé du 2026-08-21, 6 requêtes par modèle :
#   gemini-3.5-flash 6/6 · gemini-3.6-flash 5/6 · gemini-3.7-flash 4/6 · flash-latest 1/6
GEMINI_MODEL_ID=
GROQ_MODEL_ID=
MISTRAL_MODEL_ID=

# ── Slack ────────────────────────────────────────────────────────────────────
# REQUIS : xoxb-… — SlackAdapter, SlackWorkspaceService, SlackEventsHandler.
SLACK_BOT_TOKEN=
# REQUIS pour l'endpoint Events API (vérification de signature HMAC).
SLACK_SIGNING_SECRET=
# FACULTATIF — identifiant du workspace autorisé (Kisso Ind. = TMLKC4EPP).
# Défense en profondeur : la signature HMAC prouve que Slack a émis la requête,
# pas DEPUIS QUEL workspace. Comportement délibérément fail-OPEN quand la
# variable est absente — la rendre obligatoire couperait tout le trafic Slack
# tant qu'elle n'est pas déclarée dans Vercel ET le projet redéployé.
SLACK_TEAM_ID=

# ── Limitation de débit Slack ────────────────────────────────────────────────
# FACULTATIVES — bornes par personne, défauts entre parenthèses. Elles protègent
# le quota JOURNALIER Groq (≈ 100 000 tokens/jour), qui est la limite qui casse
# réellement la production.
# Rafale : messages par fenêtre courte (5). S'applique à TOUT, y compris aux
# réponses qui ne coûtent aucun token — une rafale reste une rafale.
SLACK_BURST_LIMIT=
# Journalier : messages nécessitant un appel de modèle (12). Les court-circuits
# déterministes (salutation, détresse, effacement…) en sont exemptés.
SLACK_DAILY_LIMIT=
# Budget de tokens partagé par tout le workspace et par jour (90000).
SLACK_WORKSPACE_TOKEN_BUDGET=

# ── Autorisation ─────────────────────────────────────────────────────────────
# ⚠️ LA VARIABLE LA PLUS FACILE À OUBLIER, ET SON OUBLI NE PRODUIT AUCUN SIGNAL.
# `true` fait APPLIQUER la frontière d'autorisation. Sans elle, la décision est
# calculée et journalisée, mais jamais appliquée : `SlackAccessGuard` rend `full`
# à tout le monde et n'importe qui lit le dossier RH de n'importe qui.
# Un déploiement provisionné depuis cet exemple sans cette ligne a donc une
# frontière INACTIVE — et une frontière inactive se comporte exactement comme
# une frontière qui marche, vue du côté de celui qui a le droit.
#
# ⚠️ Le garde REFUSE d'appliquer tant qu'aucun manager n'est désigné
# (slack_directory.role = 'manager') — appliquer rétrograderait tout le monde.
#   npm run probe:authz   → qui perdrait quoi (LECTURE SEULE), À FAIRE AVANT
#   npm run role:set      → inventaire ; -- --email <x> --apply pour désigner
AUTHZ_ENFORCE=false

# ── Remise quotidienne des rappels (cron Vercel) ─────────────────────────────
# REQUISE en production : sans elle, /internal/reminders/dispatch REFUSE de servir
# (503) et AUCUN rappel enregistré ne part jamais. Vercel ajoute automatiquement
# `Authorization: Bearer $CRON_SECRET` à ses invocations dès que la variable existe.
# ⚠️ Le refus est délibérément FAIL-CLOSED : sans secret, cette route serait une
# primitive publique permettant d'expédier des messages à des salariés.
#   npx vercel env add CRON_SECRET production
CRON_SECRET=

# ── Sécurité du prompt système ───────────────────────────────────────────────
# FACULTATIF — secret maître du coffre de prompts (src/shared/security/llm-guardrail.ts).
# Absent, un secret ALÉATOIRE est tiré à chaque démarrage : correct, mais alors
# rien n'est stable d'une instance froide à l'autre.
SYSTEM_PROMPT_VAULT_SECRET=

# ── Email (SMTP primaire, Brevo en repli) ────────────────────────────────────
# `createEmailProvider()` (src/mastra/index.ts) choisit SmtpAdapter dès que
# SMTP_HOST + SMTP_USER + SMTP_PASS sont TOUS renseignés, sinon BrevoAdapter.
# Arbitrage détaillé : docs/adr/006-fournisseur-email-smtp.md
#
# ⚠️ Lire `outcome`, PAS `run.status` : employeeOnboardingWorkflow rend
# `status: 'success'` même quand l'email n'est pas parti. Le verdict honnête est
# dans la charge utile (`completed | degraded | failed` + `degradedSteps`).
#
# Gmail : SMTP_PASS = mot de passe d'APPLICATION (16 car.), PAS celui du compte.
# Le mot de passe du compte est refusé : 534-5.7.9 Application-specific password
# required. Génération : Compte Google → Sécurité → Validation en deux étapes
# → Mots de passe des applications (la 2FA doit être active).
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
# Expéditeur. Doit être autorisé par le serveur SMTP (pour Gmail : = SMTP_USER).
NOTIFICATION_FROM=

# Repli uniquement. La clé peut être valide (GET /v3/account → 200) tout en
# refusant d'envoyer : POST /v3/smtp/email → 403 "Your SMTP account is not yet
# activated". Blocage côté compte Brevo, aucun contournement par le code.
BREVO_API_KEY=

# ── Authentification de l'API Mastra ─────────────────────────────────────────
# REQUIS. Bearer token partagé exigé sur TOUTES les routes intégrées `/api/*`
# (`server.auth` dans src/mastra/index.ts → src/shared/security/api-auth.ts).
# Sans lui, `POST /api/agents/:id/generate` est ouvert à Internet : n'importe qui
# pilote les agents (envoi d'email depuis la vraie boîte, création d'employés,
# publication Slack).
#
# ⚠️ FAIL-CLOSED : si la variable est absente ou fait moins de 32 caractères,
# toutes les routes /api/* répondent 401. Un déploiement sans cette variable est
# donc en panne — c'est délibéré, l'alternative rouvrirait la faille en silence.
# `/slack/events` n'est PAS concerné (requiresAuth: false + signature HMAC Slack).
#
# Génération :
#   node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
# Appel authentifié :
#   curl -H "Authorization: Bearer $MASTRA_API_TOKEN" .../api/agents
MASTRA_API_TOKEN=

# ── Accueil des arrivants ────────────────────────────────────────────────────
# FACULTATIF — noms de canaux publics (séparés par des virgules) où tout nouvel
# arrivant est invité au `team_join`. Vide ou absente ⇒ AUCUNE invitation, une
# ligne en `warn`, et la phrase « Je t'ai ajouté à … » DISPARAÎT du message
# plutôt que de promettre dans le vide.
ONBOARDING_WELCOME_CHANNELS=

# FACULTATIF depuis le 2026-08-19. La vidéo d'accueil est un actif STATIQUE du
# déploiement (public/onboarding/ → CDN) et son URL est DÉDUITE de
# VERCEL_PROJECT_PRODUCTION_URL. Cette variable ne sert plus qu'à héberger la
# vidéo ailleurs ; elle prime quand elle est posée.
ONBOARDING_VIDEO_URL=

# ── Fuseau horaire ───────────────────────────────────────────────────────────
# FACULTATIVES. Défaut : Africa/Lagos. DISPLAY_TIMEZONE prime sur
# RECRUITMENT_TIMEZONE (src/shared/french-datetime.ts).
# ⚠️ Ne poser QUE RECRUITMENT_TIMEZONE changerait l'affichage des entretiens et
# de rien d'autre — les deux lectures ont divergé une fois, ça s'est vu tard.
# L'offset est IMPRIMÉ dans l'email d'entretien : c'est le réaffichage en toutes
# lettres qui rend une erreur de date visible.
DISPLAY_TIMEZONE=
RECRUITMENT_TIMEZONE=

# ── Application ──────────────────────────────────────────────────────────────
LOG_LEVEL=debug                 # debug | info | warn | error
NODE_ENV=development            # development | staging | production | test
SERVICE_NAME=kisso-onboarding   # optionnel, métadonnée logger
APP_VERSION=0.1.0               # optionnel, métadonnée logger

# ── Tests ────────────────────────────────────────────────────────────────────
# Cible de tests/integration/live-integration.test.ts.
# Défaut : https://mastra-71ya.vercel.app
# Ce test envoie `Authorization: Bearer $MASTRA_API_TOKEN` — le token doit être
# celui du déploiement visé, sinon tous les appels /api/* répondent 401.
LIVE_TEST_BASE_URL=
# Base utilisée par les tests d'intégration (tests/integration/setup.ts).
# Défaut : file:./data/integration-test.db
INTEGRATION_DATABASE_URL=

# ──────────────────────────────────────────────────────────────────────────────
# INJECTÉES PAR LA PLATEFORME — à NE PAS déclarer ici :
#   VERCEL                          (présence = on tourne sur Vercel ; la poser
#                                    en local ferait croire au code applicatif
#                                    qu'il dispose de `waitUntil`)
#   VERCEL_PROJECT_PRODUCTION_URL   (hôte d'où l'URL de la vidéo est déduite)
#
# CONFIG MORTE — présente dans d'anciens .env, plus lue par AUCUN code :
#   OPENAI_API_KEY            (src/config/ a été SUPPRIMÉ — retiré le 2026-08-20)
#   AWS_SECRET_ID             (idem — aucun Secrets Manager n'est câblé)
#   SLACK_ORG_EMAIL_DOMAINS   (n'accorde plus rien : `full` ⟺
#                              slack_directory.role = 'manager')
#   RESEND_API_KEY            (resend.adapter.ts supprimé)
#   SLACK_USER_TOKEN          (xoxp- ; seul SLACK_BOT_TOKEN est utilisé)
#   INNGEST_EVENT_KEY / INNGEST_SIGNING_KEY (inngest installé, jamais importé)
#
# ⚠️ SLACK_TEAM_ID n'en fait PAS partie, contrairement à ce qu'un audit a cru :
# elle est lue par le contrôle de workspace du handler Slack.
# NB : SMTP_* n'en fait pas partie non plus depuis le passage à nodemailer.
# ──────────────────────────────────────────────────────────────────────────────
