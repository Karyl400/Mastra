# ──────────────────────────────────────────────
# Kisso Onboarding — Variables d'environnement
# ──────────────────────────────────────────────
# Copier ce fichier vers .env et remplir les valeurs.

# LLM Provider
OPENAI_API_KEY=
GOOGLE_GEMINI_API_KEY=

# Base de données Turso (LibSQL)
DATABASE_URL=libsql://[db-name]-[username].turso.io
DATABASE_AUTH_TOKEN=

# Email (Resend)
RESEND_API_KEY=
NOTIFICATION_FROM=noreply@kisso.com

# Slack
SLACK_BOT_TOKEN=

# Inngest (planification de tâches)
INNGEST_EVENT_KEY=
INNGEST_SIGNING_KEY=

# Application
LOG_LEVEL=debug
NODE_ENV=development
